# ==============================================================
# 1. Android 16 & Modern Userspace Core Compatibility (CRITICAL FIX)
# ==============================================================
# LZ4 ramdisk support for Android 16 vendor_boot first_stage_ramdisk
CONFIG_RD_LZ4=y
# Userfaultfd syscall required by Android ART Concurrent Mark-Compact (CMC) GC
CONFIG_USERFAULTFD=y
# Drop legacy Paranoid Network (broken in Android 13+, replaced by eBPF)
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# ==============================================================
# 2. Resolve NEW clang/LTO symbols to prevent syncconfig Restart
# ==============================================================
CONFIG_INIT_STACK_NONE=y
# CONFIG_INIT_STACK_ALL_PATTERN is not set
# CONFIG_INIT_STACK_ALL_ZERO is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_SHADOW_CALL_STACK is not set
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
# CONFIG_LTO_NONE is not set
# CONFIG_HZ_100 is not set
CONFIG_HZ_250=y

# ==============================================================
# 2. Modern Android eBPF Traffic Control & QoS Subsystem
# ==============================================================
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_CONNMARK=y

# ==============================================================
# 3. CPU Scheduling: CASS + PELT HAL Compatibility (Cirno-Pin Native)
# ==============================================================
CONFIG_SCHED_CASS=y
CONFIG_PELT_COMPATIBILITY_LAYER=y
# CONFIG_SCHED_WALT is not set
# CONFIG_SCHED_CORE_CTL is not set
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# Set schedutil as DEFAULT governor.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# CONFIG_SCHEDSTATS is not set

# ==============================================================
# 4. Storage I/O: CFQ / BFQ Flash Scheduler (UFS 2.2 Native)
# ==============================================================
CONFIG_IOSCHED_CFQ=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_DEFAULT_CFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y

# ==============================================================
# 5. Memory Subsystem: MGLRU, ZRAM ZSTD + Writeback, PSI + MEMCG (Android 13-16 LMKD / Scene-Aligned)
# ==============================================================
# Disable in-kernel SIMPLE_LMK/LMK so PSI + MEMCG can be enabled for Android LMKD & mmd
# CONFIG_ANDROID_SIMPLE_LMK is not set
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_MEMCG_KMEM=y
CONFIG_CGROUP_FREEZER=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
# Drop KSM to eliminate background page scanning CPU cycles
# CONFIG_KSM is not set
CONFIG_ZPOOL=y
# CONFIG_Z3FOLD is not set
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_ZRAM_WRITEBACK=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
# Keep PROCESS_RECLAIM enabled for kgsl GPU driver dependency (runtime controlled)
CONFIG_PROCESS_RECLAIM=y
CONFIG_COMPACTION=y

# ==============================================================
# 6. Kernel Debloat: Stripping Debug & Tracing Bloat (~200MB RAM)
# ==============================================================
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_FTRACE is not set
# CONFIG_DYNAMIC_DEBUG is not set
CONFIG_SLUB_DEBUG=n

# ==============================================================
# 7. Network Latency & Bufferbloat Mitigation (BBR + FQ)
# ==============================================================
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
# CONFIG_DEFAULT_RENO is not set
# CONFIG_DEFAULT_WESTWOOD is not set
# CONFIG_DEFAULT_HTCP is not set
# CONFIG_DEFAULT_BIC is not set
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ_CODEL=y
